{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|audio/|logo\\.png|favicon\\.svg|.*\\.dmg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Toi%20DJ.dmg",
      "destination": "/Toi DJ-macOS-Universal.dmg",
      "permanent": false
    }
  ]
}
